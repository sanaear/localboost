{
  "name": "localboost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo pour LocalBoost",
  "workspaces": [
    "frontend",
    "backend",
    "frontend-mobile"
  ],
  "scripts": {
    "install:all": "npm install",
    "test": "npm test -w frontend && npm test -w backend && npm test -w frontend-mobile",
    "test:frontend": "npm test -w frontend",
    "test:backend": "npm test -w backend",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write .",
    "dev:frontend": "npm run dev -w frontend",
    "dev:frontend:mobile": "npm run dev -w frontend-mobile",
    "dev:backend": "npm run dev -w backend",
    "db:push": "npm run db:push -w backend",
    "db:seed": "npm run seed -w backend",
    "build:all": "npm run build --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanaear/localboost.git"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3"
  },
  "license": "ISC",
  "dependencies": {
    "next": "16.2.6",
    "next-intl": "4.13.0"
  }
}
